   photoshop:DateCreated="6/12/1964"
   photoshop:Category="I"
   photoshop:Source="AP"
   photoshop:Credit="AP"
   photoshop:City="Pretoria">
   <dc:subject>
    <rdf:Bag>
     <rdf:li>Standing Crowded Holding Hand Transportation Architecture Officer On Duty</rdf:li>
    </rdf:Bag>
   </dc:subject>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Anonymous</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Protests For Mandela And Sisulu 1964</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Police join hands to hold back demonstrators outside court in Pretoria, South Africa, June 12, 1964 after eight of the accused in the Rivonia Sabotage trial, including Nelson Mandela and Walter Sisulu, were sentenced to life imprisonment. (AP Photo)</rdf:li>
    </rdf:Alt>
   </dc:description>
  </rdf:Description>
