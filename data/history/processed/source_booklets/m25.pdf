     <rdf:li>DEMONSTRATION</rdf:li>
     <rdf:li>DEMONSTRATION AGAINST</rdf:li>
     <rdf:li>APARTHEID</rdf:li>
     <rdf:li>BLACK POPULATION</rdf:li>
     <rdf:li>WOMAN</rdf:li>
