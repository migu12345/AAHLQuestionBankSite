   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">The Vanishing Gold of the Aztecs. The native Indians were enslaved and forced to work in gold and silver mines. NB: scan of small illustration</rdf:li>
    </rdf:Alt>
   </dc:description>
